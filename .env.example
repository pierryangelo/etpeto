# Local development only. Replace every credential outside a developer machine.
ETPETO_API_ADDR=:8080
ETPETO_RENDERER_ADDR=:8081
ETPETO_RENDERER_URL=http://renderer:8081
ETPETO_RENDERER_TOKEN=local-renderer-token-change-before-deploy
ETPETO_DATABASE_URL=postgres://etpeto:etpeto@postgres:5432/etpeto?sslmode=disable
ETPETO_ORGANIZATION_SLUG=default
ETPETO_ORGANIZATION_NAME=Organização de Desenvolvimento
# Used only by `make bootstrap`. The password is never read from here:
# it is typed on standard input so it stays out of files and shell history.
ETPETO_ADMIN_EMAIL=admin@orgao.gov.br
ETPETO_ADMIN_DISPLAY_NAME=Pessoa Administradora
# Raise only where many people reach the API through one address, such as an
# installation published to the internet behind NAT. Inside the organization's
# network a workstation has its own address and the default is correct.
ETPETO_THROTTLE_SCALE=1
POSTGRES_DB=etpeto
POSTGRES_USER=etpeto
POSTGRES_PASSWORD=etpeto
