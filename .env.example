# Local development only. Replace every credential outside a developer machine.
ETPETO_API_ADDR=:8080
ETPETO_RENDERER_ADDR=:8081
ETPETO_RENDERER_URL=http://renderer:8081
ETPETO_RENDERER_TOKEN=local-renderer-token-change-before-deploy
ETPETO_DATABASE_URL=postgres://etpeto:etpeto@postgres:5432/etpeto?sslmode=disable
ETPETO_ORGANIZATION_SLUG=default
POSTGRES_DB=etpeto
POSTGRES_USER=etpeto
POSTGRES_PASSWORD=etpeto
